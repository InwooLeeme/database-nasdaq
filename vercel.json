{
  "buildCommand": "cd front && npm install && npm run build",
  "outputDirectory": "front/build",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@6.44.0",
      "includeFiles": "back/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
